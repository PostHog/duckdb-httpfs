# name: test/sql/secret/secret_refresh_write_expired_token.test
# description: Tests secret refresh for returned S3 400 ExpiredToken write responses
# group: [secret]

require-env EXPIRED_TOKEN_S3_TEST_SERVER_AVAILABLE 1

require-env EXPIRED_TOKEN_S3_ENDPOINT

require-env EXPIRED_TOKEN_S3_STATE_FILE

set ignore_error_messages

require httpfs

require parquet

require json

statement ok
SET enable_logging=true

statement ok
SET s3_use_ssl=false

statement ok
SET s3_endpoint='${EXPIRED_TOKEN_S3_ENDPOINT}'

statement ok
SET s3_region='us-east-1'

statement ok
SET s3_url_style='path'

statement ok
CREATE SECRET s1 (
    TYPE S3,
    KEY_ID 'EXPIRED_TOKEN_INITIAL',
    SECRET 'INITIAL_SECRET',
    REGION 'us-east-1',
    ENDPOINT '${EXPIRED_TOKEN_S3_ENDPOINT}',
    URL_STYLE 'path',
    USE_SSL false
)

concurrentloop threadid 0 2

onlyif threadid=0
statement ok
COPY (SELECT 42 AS a) TO 's3://expired-token-write-test/result.parquet' (FORMAT 'parquet')

onlyif threadid=1
statement ok
SELECT initial_put_observed
FROM read_json_auto('http://${EXPIRED_TOKEN_S3_ENDPOINT}/__wait_for_initial_put')

onlyif threadid=1
statement ok
CREATE OR REPLACE SECRET s1 (
    TYPE S3,
    KEY_ID 'EXPIRED_TOKEN_REFRESHED',
    SECRET 'REFRESHED_SECRET',
    REGION 'us-east-1',
    ENDPOINT '${EXPIRED_TOKEN_S3_ENDPOINT}',
    URL_STYLE 'path',
    USE_SSL false
)

onlyif threadid=1
statement ok
SELECT released_expired_token_puts
FROM read_json_auto('http://${EXPIRED_TOKEN_S3_ENDPOINT}/__release_expired_token_put')

endloop

query IIIII
SELECT CASE WHEN expired_token_puts >= 1 THEN 1 ELSE 0 END,
       CASE WHEN expired_token_puts = release_expired_token_puts THEN 1 ELSE 0 END,
       CASE WHEN expired_token_puts = successful_puts THEN 1 ELSE 0 END,
       unexpected_auth_puts,
       CASE WHEN stored_bytes > 0 THEN 1 ELSE 0 END
FROM read_json_auto('${EXPIRED_TOKEN_S3_STATE_FILE}')
----
1	1	1	0	1
